{
  "name": "fisheraiagent",
  "version": "0.1.0",
  "private": true,
  "description": "One YouTube URL in, the full timed transcript out. Self-host with your own Gemini key.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "config": {
    "geminiModel": "gemini-3.8-flash"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:web": "node --import tsx test/web/browser.spec.ts",
    "start": "tsx src/cli.ts",
    "transcribe": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
