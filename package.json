{
  "name": "fisheraiagent",
  "version": "0.1.0",
  "private": true,
  "description": "One YouTube URL in, the full timed transcript out. Self-host with your own Gemini key.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "config": {
    "geminiModel": "gemini-3.8-flash"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts",
    "transcribe": "tsx src/cli.ts"
  },
  "dependencies": {
    "@google/genai": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
