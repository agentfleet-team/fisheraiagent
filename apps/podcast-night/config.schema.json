{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentfleet-team/fisheraiagent/apps/podcast-night/config.schema.json",
  "title": "morning-podcast config",
  "description": "Schema for an instance's research/morning-podcast/config.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "mode", "slots", "topics", "backlog"],
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "The stop switch: false ends the night after the config receipt."
    },
    "mode": {
      "type": "string",
      "enum": ["trial", "live"]
    },
    "slots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
      "description": "Slot start times in Asia/Taipei, e.g. [\"00:00\", \"01:00\", \"02:00\"]."
    },
    "content_at": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$",
      "default": "03:00"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "name", "queries"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 3 },
          "name": { "type": "string", "minLength": 1 },
          "queries": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "backlog": {
      "type": "array",
      "description": "Video ids already transcribed into Akina cowork/yts, each tagged with its slot (RFC-003).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "slot"],
        "properties": {
          "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "slot": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "channel_boost": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "default": {}
    },
    "deny_channels": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
