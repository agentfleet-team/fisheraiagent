{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 17620,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "各位朋友  大家午安"
    } ]
  }, {
    "tStartMs": 20740,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我是一個講師"
    } ]
  }, {
    "tStartMs": 22480,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "我幫兩岸的企業"
    } ]
  }, {
    "tStartMs": 24080,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "做創新以及說故事的訓練"
    } ]
  }, {
    "tStartMs": 26280,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "在課堂上  我就問同學說"
    } ]
  }, {
    "tStartMs": 28660,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "「請問火車上有什麼？」"
    } ]
  }, {
    "tStartMs": 32460,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "同學們會回答"
    } ]
  }, {
    "tStartMs": 33960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "火車上有乘客  有便當"
    } ]
  }, {
    "tStartMs": 37320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "有行李  有滅火器"
    } ]
  }, {
    "tStartMs": 39620,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "有車窗擊破器"
    } ]
  }, {
    "tStartMs": 41780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "當然  誇張一點的會說"
    } ]
  }, {
    "tStartMs": 43840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "老師  火車上會有痴漢"
    } ]
  }, {
    "tStartMs": 47040,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "有轟趴"
    } ]
  }, {
    "tStartMs": 49394,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "那接著我就會問同學說"
    } ]
  }, {
    "tStartMs": 51200,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "「那請問火車上沒有什麼？」"
    } ]
  }, {
    "tStartMs": 54260,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "這時候同學會說"
    } ]
  }, {
    "tStartMs": 55880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "火車上沒有大象"
    } ]
  }, {
    "tStartMs": 58080,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "沒有公園"
    } ]
  }, {
    "tStartMs": 59200,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "沒有行天宮"
    } ]
  }, {
    "tStartMs": 60661,
    "dDurationMs": 1143,
    "segs": [ {
      "utf8": "沒有夜市"
    } ]
  }, {
    "tStartMs": 61804,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "沒有游泳池"
    } ]
  }, {
    "tStartMs": 63181,
    "dDurationMs": 1018,
    "segs": [ {
      "utf8": "沒有賭場"
    } ]
  }, {
    "tStartMs": 64600,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "我說  好"
    } ]
  }, {
    "tStartMs": 65700,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "那如果台鐵要找我們研發一款新的火車"
    } ]
  }, {
    "tStartMs": 69700,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "是不是我們把剛剛講的"
    } ]
  }, {
    "tStartMs": 71700,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "那些沒有的放幾個上去"
    } ]
  }, {
    "tStartMs": 73820,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "會很厲害？"
    } ]
  }, {
    "tStartMs": 75540,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "假設我們把士林夜市"
    } ]
  }, {
    "tStartMs": 77740,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "搬上火車"
    } ]
  }, {
    "tStartMs": 79020,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "搞出一個「霍爾的移動夜市」"
    } ]
  }, {
    "tStartMs": 82260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "讓你火車頭吃到火車尾"
    } ]
  }, {
    "tStartMs": 85240,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "你覺得酷不酷？"
    } ]
  }, {
    "tStartMs": 86900,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "蠻酷的"
    } ]
  }, {
    "tStartMs": 88440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你說  這一招叫什麼招？"
    } ]
  }, {
    "tStartMs": 90840,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "各位  這一招叫做"
    } ]
  }, {
    "tStartMs": 92600,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "「跟沒有借東西」"
    } ]
  }, {
    "tStartMs": 95380,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "各位來看ㄧ下"
    } ]
  }, {
    "tStartMs": 96440,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "日本在2017年"
    } ]
  }, {
    "tStartMs": 97740,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "準備把什麼放進火車？"
    } ]
  }, {
    "tStartMs": 98940,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "你看"
    } ]
  }, {
    "tStartMs": 99680,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "他們把五星級飯店的大廳放進來"
    } ]
  }, {
    "tStartMs": 102360,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "他們把小豪宅放進來"
    } ]
  }, {
    "tStartMs": 105220,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "所以各位  如果你想跟別人不一樣"
    } ]
  }, {
    "tStartMs": 107900,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "就要懂得跟「沒有」借東西"
    } ]
  }, {
    "tStartMs": 110640,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "去問  你的產品沒有什麼？"
    } ]
  }, {
    "tStartMs": 112640,
    "dDurationMs": 1798,
    "segs": [ {
      "utf8": "你的服務沒有什麼？"
    } ]
  }, {
    "tStartMs": 114438,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "你的行銷沒有什麼？"
    } ]
  }, {
    "tStartMs": 116118,
    "dDurationMs": 1959,
    "segs": [ {
      "utf8": "你的記者會沒有什麼？"
    } ]
  }, {
    "tStartMs": 118280,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "這樣  你就可以做出跟別人不一樣的東西"
    } ]
  }, {
    "tStartMs": 121600,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "為了要讓同學們現學現賣"
    } ]
  }, {
    "tStartMs": 123820,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "所以我現場就會問大家"
    } ]
  }, {
    "tStartMs": 125780,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "請問你的工作「沒有」什麼？"
    } ]
  }, {
    "tStartMs": 129076,
    "dDurationMs": 2124,
    "segs": [ {
      "utf8": "同學們會想一下  然後回答說"
    } ]
  }, {
    "tStartMs": 131200,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "我的工作沒有加班費"
    } ]
  }, {
    "tStartMs": 134640,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "沒有交通車"
    } ]
  }, {
    "tStartMs": 136200,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "沒有托兒所"
    } ]
  }, {
    "tStartMs": 137360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "沒有遊戲間"
    } ]
  }, {
    "tStartMs": 138620,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "沒有沙灘"
    } ]
  }, {
    "tStartMs": 139560,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "沒有辣妹"
    } ]
  }, {
    "tStartMs": 140980,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "當然  更誇張的會講說"
    } ]
  }, {
    "tStartMs": 142480,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "「老師  我的工作"
    } ]
  }, {
    "tStartMs": 143860,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "沒有尊嚴」"
    } ]
  }, {
    "tStartMs": 146300,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "沒有未來"
    } ]
  }, {
    "tStartMs": 148040,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "同學們會講很多跟福利有關的東西"
    } ]
  }, {
    "tStartMs": 151600,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "然後越講越哀怨"
    } ]
  }, {
    "tStartMs": 153620,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "這時我就會想說"
    } ]
  }, {
    "tStartMs": 155180,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "那你們有認真想過"
    } ]
  }, {
    "tStartMs": 156900,
    "dDurationMs": 1818,
    "segs": [ {
      "utf8": "「有」跟「沒有」這件事情嗎？"
    } ]
  }, {
    "tStartMs": 158718,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "我的理解是這樣"
    } ]
  }, {
    "tStartMs": 160400,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "如果你家裡有菲傭"
    } ]
  }, {
    "tStartMs": 162680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "慢慢地  你就不會做家事了"
    } ]
  }, {
    "tStartMs": 166080,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "如果妳朋友很多"
    } ]
  }, {
    "tStartMs": 167620,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "妳就會耐不住寂寞"
    } ]
  }, {
    "tStartMs": 169122,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "如果你有一個有錢的老爸"
    } ]
  }, {
    "tStartMs": 171198,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "那麼除了上夜店、打警察之外"
    } ]
  }, {
    "tStartMs": 173198,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "你大概什麼都不會"
    } ]
  }, {
    "tStartMs": 177400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "那你說  火星爺爺照你這樣講"
    } ]
  }, {
    "tStartMs": 179657,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "難道「沒有」會比「有」還要好嗎？"
    } ]
  }, {
    "tStartMs": 181892,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "當然  各位"
    } ]
  }, {
    "tStartMs": 183160,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "這是馬雲說的"
    } ]
  }, {
    "tStartMs": 184437,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "馬雲說  「阿里巴巴成功"
    } ]
  }, {
    "tStartMs": 186460,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "是因為沒有錢、"
    } ]
  }, {
    "tStartMs": 187960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "沒有技術、沒有計劃」"
    } ]
  }, {
    "tStartMs": 191440,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "我完全認同馬雲的說法"
    } ]
  }, {
    "tStartMs": 194020,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "我就拿自己當例子好了"
    } ]
  }, {
    "tStartMs": 196080,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "各位  你看著我拿拐杖"
    } ]
  }, {
    "tStartMs": 198620,
    "dDurationMs": 1213,
    "segs": [ {
      "utf8": "站在講台上  對不對？"
    } ]
  }, {
    "tStartMs": 200040,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "我是不是沒有你方便？"
    } ]
  }, {
    "tStartMs": 202720,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "是吧？"
    } ]
  }, {
    "tStartMs": 203540,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "可是各位  不要被表象給蒙蔽了"
    } ]
  }, {
    "tStartMs": 205754,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "我雖然沒有你方便"
    } ]
  }, {
    "tStartMs": 207520,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "可是呢  你的天使"
    } ]
  }, {
    "tStartMs": 208900,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "可是沒有我這麼多"
    } ]
  }, {
    "tStartMs": 211158,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "每當我拉著行李走在路上"
    } ]
  }, {
    "tStartMs": 213520,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "我都拉不了太遠、太久"
    } ]
  }, {
    "tStartMs": 216060,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "就會有人衝過來"
    } ]
  }, {
    "tStartMs": 217320,
    "dDurationMs": 1658,
    "segs": [ {
      "utf8": "「先生  我幫你」"
    } ]
  }, {
    "tStartMs": 219240,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "下雨天的時候  我幾乎不需要撐傘"
    } ]
  }, {
    "tStartMs": 222000,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "因為人群裡面"
    } ]
  }, {
    "tStartMs": 223180,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "就一定會有一個人"
    } ]
  }, {
    "tStartMs": 224460,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "撐著傘  朝我走過來"
    } ]
  }, {
    "tStartMs": 226140,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "「先生  去哪裡？"
    } ]
  }, {
    "tStartMs": 227420,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "我送你」"
    } ]
  }, {
    "tStartMs": 228420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "各位  我記得有一次"
    } ]
  }, {
    "tStartMs": 230040,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "我要從鎮州搭小飛機"
    } ]
  }, {
    "tStartMs": 231800,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "去西安上課"
    } ]
  }, {
    "tStartMs": 233280,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "天呀  各位"
    } ]
  }, {
    "tStartMs": 233940,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "那個小飛機的台階"
    } ]
  }, {
    "tStartMs": 235580,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "我完全上不去"
    } ]
  }, {
    "tStartMs": 237180,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "我還在煩惱該怎麼辦的時候"
    } ]
  }, {
    "tStartMs": 239200,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "一個大哥就在我面前蹲下來"
    } ]
  }, {
    "tStartMs": 241560,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "「趴上來  我揹你！」"
    } ]
  }, {
    "tStartMs": 244660,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "他就這樣把我揹上去"
    } ]
  }, {
    "tStartMs": 246260,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "到了西安又把我揹下來"
    } ]
  }, {
    "tStartMs": 248720,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "各位  這種天使多到你難以想像"
    } ]
  }, {
    "tStartMs": 251340,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "而且呢  有時候不用開口就會有"
    } ]
  }, {
    "tStartMs": 253900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "我記得  我雖然沒有你方便"
    } ]
  }, {
    "tStartMs": 256680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "可是我橫渡過日月潭兩次"
    } ]
  }, {
    "tStartMs": 259260,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "而且呢  我拍過微電影"
    } ]
  }, {
    "tStartMs": 261517,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "而且呢  我經常一個人出國自助旅行"
    } ]
  }, {
    "tStartMs": 264340,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "而且  各位"
    } ]
  }, {
    "tStartMs": 265580,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "我還演過MV喔"
    } ]
  }, {
    "tStartMs": 268020,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "如果你不信  你下次去KTV"
    } ]
  }, {
    "tStartMs": 269720,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "幫我點一首歌"
    } ]
  }, {
    "tStartMs": 270980,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "周華健「有故事的人」"
    } ]
  }, {
    "tStartMs": 272660,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "本人在裡面  十五秒"
    } ]
  }, {
    "tStartMs": 279480,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "OK  好"
    } ]
  }, {
    "tStartMs": 282580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "我記得我在寫第一本書的時候"
    } ]
  }, {
    "tStartMs": 284780,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我想說  我只是一個普通的上班族"
    } ]
  }, {
    "tStartMs": 286740,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "我沒有名氣  也沒有地位"
    } ]
  }, {
    "tStartMs": 288300,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "誰要看你的書？"
    } ]
  }, {
    "tStartMs": 289860,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "還好  我有跟「沒有」借東西"
    } ]
  }, {
    "tStartMs": 292580,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我借了我小時候最愛看的"
    } ]
  }, {
    "tStartMs": 294540,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "卡通科學小飛俠"
    } ]
  }, {
    "tStartMs": 296120,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "我假裝自己是"
    } ]
  }, {
    "tStartMs": 297480,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "卡通裡的南宮博士"
    } ]
  }, {
    "tStartMs": 299300,
    "dDurationMs": 2894,
    "segs": [ {
      "utf8": "開始給科學小飛俠寫備忘錄"
    } ]
  }, {
    "tStartMs": 302374,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "就這樣  我出版了我第一本書"
    } ]
  }, {
    "tStartMs": 304640,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "之後呢  我一路跟「沒有」借東西"
    } ]
  }, {
    "tStartMs": 307220,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "然後出版了五本書"
    } ]
  }, {
    "tStartMs": 308946,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "這幾年呢  我寫了一個故事"
    } ]
  }, {
    "tStartMs": 311400,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "講一個包包跟它的主人分開了"
    } ]
  }, {
    "tStartMs": 314340,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "它自己去流浪"
    } ]
  }, {
    "tStartMs": 315700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "可是呢  它沒有因為沒有主人"
    } ]
  }, {
    "tStartMs": 317980,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "就頹廢"
    } ]
  }, {
    "tStartMs": 318700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "它跑去應徵快遞"
    } ]
  }, {
    "tStartMs": 320540,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "非常地努力"
    } ]
  }, {
    "tStartMs": 321980,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "而且呢  它還去當街頭藝人"
    } ]
  }, {
    "tStartMs": 324620,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "最後還成立包包馬戲團"
    } ]
  }, {
    "tStartMs": 327500,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "帶給很多人歡樂"
    } ]
  }, {
    "tStartMs": 329528,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "各位  寫這個故事是想跟大家分享"
    } ]
  }, {
    "tStartMs": 331845,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "你不會因為擁有誰"
    } ]
  }, {
    "tStartMs": 333705,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "就變得完整"
    } ]
  }, {
    "tStartMs": 334905,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "你也不會因為沒有誰"
    } ]
  }, {
    "tStartMs": 336585,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "就變得不完整"
    } ]
  }, {
    "tStartMs": 338235,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你本來就是完整的"
    } ]
  }, {
    "tStartMs": 340500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "我們這本書還沒有出版"
    } ]
  }, {
    "tStartMs": 342540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "可是已經得到2014年"
    } ]
  }, {
    "tStartMs": 344440,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "德國的紅點設計獎"
    } ]
  }, {
    "tStartMs": 348060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "我發現  我沒有你方便這件事情"
    } ]
  }, {
    "tStartMs": 350260,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "完全阻止不了（自）我豐盛"
    } ]
  }, {
    "tStartMs": 352580,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "各位  這張照片是三年前"
    } ]
  }, {
    "tStartMs": 354440,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "我在芬蘭北極圈"
    } ]
  }, {
    "tStartMs": 356500,
    "dDurationMs": 1707,
    "segs": [ {
      "utf8": "聖誕老人村拍的照片"
    } ]
  }, {
    "tStartMs": 358560,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "你知道嗎？"
    } ]
  }, {
    "tStartMs": 359080,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "拍這張照片的時候"
    } ]
  }, {
    "tStartMs": 360540,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "我心情非常激動"
    } ]
  }, {
    "tStartMs": 362140,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "你知道為什麼？"
    } ]
  }, {
    "tStartMs": 363140,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "因為拍這張照片"
    } ]
  }, {
    "tStartMs": 365200,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "要49歐元"
    } ]
  }, {
    "tStartMs": 369380,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "好  我激動的不是49歐元"
    } ]
  }, {
    "tStartMs": 371540,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我激動的是  那一刻"
    } ]
  }, {
    "tStartMs": 374020,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "我才明白到"
    } ]
  }, {
    "tStartMs": 375274,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我八個月大就小兒麻痺"
    } ]
  }, {
    "tStartMs": 377540,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "七歲之前都不會走路"
    } ]
  }, {
    "tStartMs": 379500,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "我竟然可以走這麼遠"
    } ]
  }, {
    "tStartMs": 381820,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "所以我想跟你分享"
    } ]
  }, {
    "tStartMs": 383220,
    "dDurationMs": 1937,
    "segs": [ {
      "utf8": "「沒有」它不是一份限制"
    } ]
  }, {
    "tStartMs": 385157,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "「沒有」是一份禮物"
    } ]
  }, {
    "tStartMs": 387080,
    "dDurationMs": 1095,
    "segs": [ {
      "utf8": "如果你什麼都沒有"
    } ]
  }, {
    "tStartMs": 388300,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "那你應該去想"
    } ]
  }, {
    "tStartMs": 389800,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "你該怎麼去創造？"
    } ]
  }, {
    "tStartMs": 393054,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "你把焦點放在創造"
    } ]
  }, {
    "tStartMs": 395054,
    "dDurationMs": 1239,
    "segs": [ {
      "utf8": "不要放在「沒有」"
    } ]
  }, {
    "tStartMs": 396633,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "我就遇到  這幾年"
    } ]
  }, {
    "tStartMs": 397760,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "有一些年輕人"
    } ]
  }, {
    "tStartMs": 399040,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "會抱怨自己沒有好的家世背景"
    } ]
  }, {
    "tStartMs": 401640,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "沒有好的條件"
    } ]
  }, {
    "tStartMs": 403640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "薪水很低  然後房價很高"
    } ]
  }, {
    "tStartMs": 405480,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "看不到未來"
    } ]
  }, {
    "tStartMs": 406600,
    "dDurationMs": 1505,
    "segs": [ {
      "utf8": "我知道這是現實"
    } ]
  }, {
    "tStartMs": 408105,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "可是我也想跟大家分享的是"
    } ]
  }, {
    "tStartMs": 410060,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "一個掉到糞坑裡面"
    } ]
  }, {
    "tStartMs": 411900,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "又一直抱怨糞坑很臭的人"
    } ]
  }, {
    "tStartMs": 413900,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "是走不出糞坑的"
    } ]
  }, {
    "tStartMs": 416020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "我覺得大環境只是告訴我們說"
    } ]
  }, {
    "tStartMs": 417900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "繼續走以前的老路"
    } ]
  }, {
    "tStartMs": 419400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "應該是行不通"
    } ]
  }, {
    "tStartMs": 420680,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "我們應該要做出改變"
    } ]
  }, {
    "tStartMs": 422500,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "你說  火星爺爺"
    } ]
  }, {
    "tStartMs": 423720,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "現實總是要顧一下吧？"
    } ]
  }, {
    "tStartMs": 425440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "我總不能夠放棄現在的工作"
    } ]
  }, {
    "tStartMs": 427440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "跑去追求夢想吧？"
    } ]
  }, {
    "tStartMs": 429440,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "各位  如果這是你的問題"
    } ]
  }, {
    "tStartMs": 430960,
    "dDurationMs": 1943,
    "segs": [ {
      "utf8": "那我介紹五個人給你認識"
    } ]
  }, {
    "tStartMs": 433369,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "這五個人分別是"
    } ]
  }, {
    "tStartMs": 434860,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "記者、攝影師、企業家、工程師、物理學家"
    } ]
  }, {
    "tStartMs": 439400,
    "dDurationMs": 1394,
    "segs": [ {
      "utf8": "他們的名字分別是"
    } ]
  }, {
    "tStartMs": 441420,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "克拉克·肯特"
    } ]
  }, {
    "tStartMs": 442620,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "彼得·帕克"
    } ]
  }, {
    "tStartMs": 443800,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "布魯斯·韋恩"
    } ]
  }, {
    "tStartMs": 445100,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "東尼·史塔克"
    } ]
  }, {
    "tStartMs": 447080,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "布魯斯·班納"
    } ]
  }, {
    "tStartMs": 448200,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "很熟對嗎？"
    } ]
  }, {
    "tStartMs": 449840,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "下班之後  他們就變身成"
    } ]
  }, {
    "tStartMs": 452320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "超人  蜘蛛人"
    } ]
  }, {
    "tStartMs": 453880,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "蝙蝠俠   鋼鐵人  綠巨人"
    } ]
  }, {
    "tStartMs": 458720,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "各位  這五個人的故事"
    } ]
  }, {
    "tStartMs": 461640,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "各位  這五個人的故事"
    } ]
  }, {
    "tStartMs": 462720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "帶給我們最大的啟示是什麼？"
    } ]
  }, {
    "tStartMs": 464660,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "超人的偉大事業"
    } ]
  }, {
    "tStartMs": 465820,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "都是從下班後開始的"
    } ]
  }, {
    "tStartMs": 472700,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "所以  各位"
    } ]
  }, {
    "tStartMs": 473380,
    "dDurationMs": 1817,
    "segs": [ {
      "utf8": "你有打算變身成超人"
    } ]
  }, {
    "tStartMs": 475197,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "拯救你自己嗎？"
    } ]
  }, {
    "tStartMs": 476660,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "自己的未來自己救"
    } ]
  }, {
    "tStartMs": 478618,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "所以  在這邊我想要跟大家分享是說"
    } ]
  }, {
    "tStartMs": 481060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "如果呢  你繼承ㄧ個果園"
    } ]
  }, {
    "tStartMs": 483220,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "恭喜你  你馬上有現成的水果可以吃"
    } ]
  }, {
    "tStartMs": 486140,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "那如果你繼承的是個荒地"
    } ]
  }, {
    "tStartMs": 488040,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "那我也要恭喜你"
    } ]
  }, {
    "tStartMs": 489540,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "因為你可能會擁有"
    } ]
  }, {
    "tStartMs": 490500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "讓荒地長出果實的能力"
    } ]
  }, {
    "tStartMs": 492960,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "你知道從一開始到現在"
    } ]
  }, {
    "tStartMs": 494360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "我講了幾次「沒有」嗎？"
    } ]
  }, {
    "tStartMs": 495980,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "49次"
    } ]
  }, {
    "tStartMs": 498340,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "你知道嗎？"
    } ]
  }, {
    "tStartMs": 499320,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "如果穿越夠多的「沒有」"
    } ]
  }, {
    "tStartMs": 501420,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "就能夠站上TED的講台"
    } ]
  }, {
    "tStartMs": 503068,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "分享你的故事"
    } ]
  }, {
    "tStartMs": 504640,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "我想要跟你分享的是什麼呢？"
    } ]
  }, {
    "tStartMs": 506200,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "我覺得困住我們的"
    } ]
  }, {
    "tStartMs": 507700,
    "dDurationMs": 1613,
    "segs": [ {
      "utf8": "從來不是我們「沒有」什麼"
    } ]
  }, {
    "tStartMs": 509520,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "而是我們如何看待「沒有」"
    } ]
  }, {
    "tStartMs": 512374,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "各位  就讓「沒有」帶領我們豐盛吧"
    } ]
  }, {
    "tStartMs": 515660,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "謝謝你"
    } ]
  } ]
}
