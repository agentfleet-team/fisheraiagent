{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 12645,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "So in college,"
    } ]
  }, {
    "tStartMs": 15349,
    "dDurationMs": 1564,
    "segs": [ {
      "utf8": "I was a government major,"
    } ]
  }, {
    "tStartMs": 16937,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "which means I had to write\na lot of papers."
    } ]
  }, {
    "tStartMs": 19423,
    "dDurationMs": 2048,
    "segs": [ {
      "utf8": "Now, when a normal student writes a paper,"
    } ]
  }, {
    "tStartMs": 21495,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "they might spread the work out\na little like this."
    } ]
  }, {
    "tStartMs": 23892,
    "dDurationMs": 1151,
    "segs": [ {
      "utf8": "So, you know --"
    } ]
  }, {
    "tStartMs": 25067,
    "dDurationMs": 1657,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 26748,
    "dDurationMs": 1827,
    "segs": [ {
      "utf8": "you get started maybe a little slowly,"
    } ]
  }, {
    "tStartMs": 28599,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "but you get enough done in the first week"
    } ]
  }, {
    "tStartMs": 30591,
    "dDurationMs": 1831,
    "segs": [ {
      "utf8": "that, with some heavier days later on,"
    } ]
  }, {
    "tStartMs": 32446,
    "dDurationMs": 2157,
    "segs": [ {
      "utf8": "everything gets done, things stay civil."
    } ]
  }, {
    "tStartMs": 34627,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 35853,
    "dDurationMs": 2271,
    "segs": [ {
      "utf8": "And I would want to do that like that."
    } ]
  }, {
    "tStartMs": 38148,
    "dDurationMs": 1194,
    "segs": [ {
      "utf8": "That would be the plan."
    } ]
  }, {
    "tStartMs": 39366,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "I would have it all ready to go,"
    } ]
  }, {
    "tStartMs": 41880,
    "dDurationMs": 2494,
    "segs": [ {
      "utf8": "but then, actually, the paper\nwould come along,"
    } ]
  }, {
    "tStartMs": 44398,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "and then I would kind of do this."
    } ]
  }, {
    "tStartMs": 46363,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 48757,
    "dDurationMs": 2143,
    "segs": [ {
      "utf8": "And that would happen every single paper."
    } ]
  }, {
    "tStartMs": 51638,
    "dDurationMs": 3882,
    "segs": [ {
      "utf8": "But then came my 90-page senior thesis,"
    } ]
  }, {
    "tStartMs": 55544,
    "dDurationMs": 2287,
    "segs": [ {
      "utf8": "a paper you're supposed\nto spend a year on."
    } ]
  }, {
    "tStartMs": 57855,
    "dDurationMs": 3619,
    "segs": [ {
      "utf8": "And I knew for a paper like that,\nmy normal work flow was not an option."
    } ]
  }, {
    "tStartMs": 61498,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "It was way too big a project."
    } ]
  }, {
    "tStartMs": 62923,
    "dDurationMs": 1153,
    "segs": [ {
      "utf8": "So I planned things out,"
    } ]
  }, {
    "tStartMs": 64100,
    "dDurationMs": 3205,
    "segs": [ {
      "utf8": "and I decided I kind of had\nto go something like this."
    } ]
  }, {
    "tStartMs": 67781,
    "dDurationMs": 1452,
    "segs": [ {
      "utf8": "This is how the year would go."
    } ]
  }, {
    "tStartMs": 69257,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "So I'd start off light,"
    } ]
  }, {
    "tStartMs": 71248,
    "dDurationMs": 2318,
    "segs": [ {
      "utf8": "and I'd bump it up in the middle months,"
    } ]
  }, {
    "tStartMs": 73590,
    "dDurationMs": 2626,
    "segs": [ {
      "utf8": "and then at the end,\nI would kick it up into high gear"
    } ]
  }, {
    "tStartMs": 76240,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "just like a little staircase."
    } ]
  }, {
    "tStartMs": 77703,
    "dDurationMs": 2062,
    "segs": [ {
      "utf8": "How hard could it be\nto walk up the stairs?"
    } ]
  }, {
    "tStartMs": 80233,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "No big deal, right?"
    } ]
  }, {
    "tStartMs": 83090,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "But then, the funniest thing happened."
    } ]
  }, {
    "tStartMs": 84924,
    "dDurationMs": 1311,
    "segs": [ {
      "utf8": "Those first few months?"
    } ]
  }, {
    "tStartMs": 86791,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "They came and went,"
    } ]
  }, {
    "tStartMs": 87982,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "and I couldn't quite do stuff."
    } ]
  }, {
    "tStartMs": 89591,
    "dDurationMs": 1849,
    "segs": [ {
      "utf8": "So we had an awesome new revised plan."
    } ]
  }, {
    "tStartMs": 91464,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 92655,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "And then --"
    } ]
  }, {
    "tStartMs": 93838,
    "dDurationMs": 1882,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 95744,
    "dDurationMs": 2784,
    "segs": [ {
      "utf8": "But then those middle months\nactually went by,"
    } ]
  }, {
    "tStartMs": 98552,
    "dDurationMs": 2182,
    "segs": [ {
      "utf8": "and I didn't really write words,"
    } ]
  }, {
    "tStartMs": 100758,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "and so we were here."
    } ]
  }, {
    "tStartMs": 103500,
    "dDurationMs": 2576,
    "segs": [ {
      "utf8": "And then two months turned into one month,"
    } ]
  }, {
    "tStartMs": 106100,
    "dDurationMs": 1625,
    "segs": [ {
      "utf8": "which turned into two weeks."
    } ]
  }, {
    "tStartMs": 107749,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "And one day I woke up"
    } ]
  }, {
    "tStartMs": 109724,
    "dDurationMs": 2619,
    "segs": [ {
      "utf8": "with three days until the deadline,"
    } ]
  }, {
    "tStartMs": 113502,
    "dDurationMs": 1931,
    "segs": [ {
      "utf8": "still not having written a word,"
    } ]
  }, {
    "tStartMs": 115457,
    "dDurationMs": 2059,
    "segs": [ {
      "utf8": "and so I did the only thing I could:"
    } ]
  }, {
    "tStartMs": 117540,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "I wrote 90 pages over 72 hours,"
    } ]
  }, {
    "tStartMs": 120171,
    "dDurationMs": 2276,
    "segs": [ {
      "utf8": "pulling not one but two all-nighters --"
    } ]
  }, {
    "tStartMs": 122471,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "humans are not supposed to pull\ntwo all-nighters --"
    } ]
  }, {
    "tStartMs": 126373,
    "dDurationMs": 1993,
    "segs": [ {
      "utf8": "sprinted across campus,"
    } ]
  }, {
    "tStartMs": 128390,
    "dDurationMs": 1486,
    "segs": [ {
      "utf8": "dove in slow motion,"
    } ]
  }, {
    "tStartMs": 129900,
    "dDurationMs": 2056,
    "segs": [ {
      "utf8": "and got it in just at the deadline."
    } ]
  }, {
    "tStartMs": 131980,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "I thought that was the end of everything."
    } ]
  }, {
    "tStartMs": 134028,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "But a week later I get a call,"
    } ]
  }, {
    "tStartMs": 135611,
    "dDurationMs": 1486,
    "segs": [ {
      "utf8": "and it's the school."
    } ]
  }, {
    "tStartMs": 137757,
    "dDurationMs": 1639,
    "segs": [ {
      "utf8": "And they say, \"Is this Tim Urban?\""
    } ]
  }, {
    "tStartMs": 139420,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "And I say, \"Yeah.\""
    } ]
  }, {
    "tStartMs": 140912,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And they say, \"We need\nto talk about your thesis.\""
    } ]
  }, {
    "tStartMs": 143276,
    "dDurationMs": 1255,
    "segs": [ {
      "utf8": "And I say, \"OK.\""
    } ]
  }, {
    "tStartMs": 145468,
    "dDurationMs": 1222,
    "segs": [ {
      "utf8": "And they say,"
    } ]
  }, {
    "tStartMs": 147230,
    "dDurationMs": 1896,
    "segs": [ {
      "utf8": "\"It's the best one we've ever seen.\""
    } ]
  }, {
    "tStartMs": 149150,
    "dDurationMs": 1705,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 152014,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "(Applause)"
    } ]
  }, {
    "tStartMs": 156945,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "That did not happen."
    } ]
  }, {
    "tStartMs": 158271,
    "dDurationMs": 2138,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 160433,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": "It was a very, very bad thesis."
    } ]
  }, {
    "tStartMs": 163080,
    "dDurationMs": 2274,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 165378,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "I just wanted to enjoy that one moment\nwhen all of you thought,"
    } ]
  }, {
    "tStartMs": 169502,
    "dDurationMs": 1905,
    "segs": [ {
      "utf8": "\"This guy is amazing!\""
    } ]
  }, {
    "tStartMs": 171431,
    "dDurationMs": 1348,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 172803,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "No, no, it was very, very bad."
    } ]
  }, {
    "tStartMs": 175343,
    "dDurationMs": 3408,
    "segs": [ {
      "utf8": "Anyway, today I'm a writer-blogger guy."
    } ]
  }, {
    "tStartMs": 178775,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "I write the blog Wait But Why."
    } ]
  }, {
    "tStartMs": 180542,
    "dDurationMs": 3736,
    "segs": [ {
      "utf8": "And a couple of years ago,\nI decided to write about procrastination."
    } ]
  }, {
    "tStartMs": 184302,
    "dDurationMs": 3284,
    "segs": [ {
      "utf8": "My behavior has always perplexed\nthe non-procrastinators around me,"
    } ]
  }, {
    "tStartMs": 187610,
    "dDurationMs": 3688,
    "segs": [ {
      "utf8": "and I wanted to explain\nto the non-procrastinators of the world"
    } ]
  }, {
    "tStartMs": 191322,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "what goes on in the heads\nof procrastinators,"
    } ]
  }, {
    "tStartMs": 193453,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and why we are the way we are."
    } ]
  }, {
    "tStartMs": 194917,
    "dDurationMs": 1156,
    "segs": [ {
      "utf8": "Now, I had a hypothesis"
    } ]
  }, {
    "tStartMs": 196097,
    "dDurationMs": 2855,
    "segs": [ {
      "utf8": "that the brains of procrastinators\nwere actually different"
    } ]
  }, {
    "tStartMs": 198976,
    "dDurationMs": 1957,
    "segs": [ {
      "utf8": "than the brains of other people."
    } ]
  }, {
    "tStartMs": 201698,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "And to test this, I found an MRI lab"
    } ]
  }, {
    "tStartMs": 203913,
    "dDurationMs": 2432,
    "segs": [ {
      "utf8": "that actually let me scan both my brain"
    } ]
  }, {
    "tStartMs": 206369,
    "dDurationMs": 2655,
    "segs": [ {
      "utf8": "and the brain of a proven\nnon-procrastinator,"
    } ]
  }, {
    "tStartMs": 209048,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "so I could compare them."
    } ]
  }, {
    "tStartMs": 210507,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "I actually brought them here\nto show you today."
    } ]
  }, {
    "tStartMs": 212732,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "I want you to take a look carefully\nto see if you can notice a difference."
    } ]
  }, {
    "tStartMs": 216293,
    "dDurationMs": 2314,
    "segs": [ {
      "utf8": "I know that if you're not\na trained brain expert,"
    } ]
  }, {
    "tStartMs": 218631,
    "dDurationMs": 2263,
    "segs": [ {
      "utf8": "it's not that obvious,\nbut just take a look, OK?"
    } ]
  }, {
    "tStartMs": 220918,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "So here's the brain\nof a non-procrastinator."
    } ]
  }, {
    "tStartMs": 223835,
    "dDurationMs": 2274,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 226133,
    "dDurationMs": 1151,
    "segs": [ {
      "utf8": "Now ..."
    } ]
  }, {
    "tStartMs": 228325,
    "dDurationMs": 1314,
    "segs": [ {
      "utf8": "here's my brain."
    } ]
  }, {
    "tStartMs": 230280,
    "dDurationMs": 2726,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 235713,
    "dDurationMs": 1564,
    "segs": [ {
      "utf8": "There is a difference."
    } ]
  }, {
    "tStartMs": 237904,
    "dDurationMs": 2388,
    "segs": [ {
      "utf8": "Both brains have a Rational\nDecision-Maker in them,"
    } ]
  }, {
    "tStartMs": 240316,
    "dDurationMs": 1652,
    "segs": [ {
      "utf8": "but the procrastinator's brain"
    } ]
  }, {
    "tStartMs": 241992,
    "dDurationMs": 2986,
    "segs": [ {
      "utf8": "also has an Instant Gratification Monkey."
    } ]
  }, {
    "tStartMs": 245002,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "Now, what does this mean\nfor the procrastinator?"
    } ]
  }, {
    "tStartMs": 247328,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "Well, it means everything's fine\nuntil this happens."
    } ]
  }, {
    "tStartMs": 249793,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "[This is a perfect time\nto get some work done.] [Nope!]"
    } ]
  }, {
    "tStartMs": 252439,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "So the Rational Decision-Maker\nwill make the rational decision"
    } ]
  }, {
    "tStartMs": 255396,
    "dDurationMs": 1896,
    "segs": [ {
      "utf8": "to do something productive,"
    } ]
  }, {
    "tStartMs": 257316,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "but the Monkey doesn't like that plan,"
    } ]
  }, {
    "tStartMs": 259290,
    "dDurationMs": 1508,
    "segs": [ {
      "utf8": "so he actually takes the wheel,"
    } ]
  }, {
    "tStartMs": 260822,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "and he says, \"Actually, let's read\nthe entire Wikipedia page"
    } ]
  }, {
    "tStartMs": 263727,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "of the Nancy Kerrigan/\nTonya Harding scandal,"
    } ]
  }, {
    "tStartMs": 265887,
    "dDurationMs": 2131,
    "segs": [ {
      "utf8": "because I just remembered\nthat that happened."
    } ]
  }, {
    "tStartMs": 268042,
    "dDurationMs": 1016,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 269082,
    "dDurationMs": 1158,
    "segs": [ {
      "utf8": "Then --"
    } ]
  }, {
    "tStartMs": 270264,
    "dDurationMs": 1263,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 271551,
    "dDurationMs": 2038,
    "segs": [ {
      "utf8": "Then we're going to go over to the fridge,"
    } ]
  }, {
    "tStartMs": 273613,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "to see if there's anything new\nin there since 10 minutes ago."
    } ]
  }, {
    "tStartMs": 276503,
    "dDurationMs": 2638,
    "segs": [ {
      "utf8": "After that, we're going to go\non a YouTube spiral"
    } ]
  }, {
    "tStartMs": 279165,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "that starts with videos\nof Richard Feynman talking about magnets"
    } ]
  }, {
    "tStartMs": 282439,
    "dDurationMs": 2716,
    "segs": [ {
      "utf8": "and ends much, much later\nwith us watching interviews"
    } ]
  }, {
    "tStartMs": 285179,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "with Justin Bieber's mom."
    } ]
  }, {
    "tStartMs": 287083,
    "dDurationMs": 2188,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 289295,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "\"All of that's going to take a while,"
    } ]
  }, {
    "tStartMs": 291082,
    "dDurationMs": 3502,
    "segs": [ {
      "utf8": "so we're not going to really have room\non the schedule for any work today."
    } ]
  }, {
    "tStartMs": 294608,
    "dDurationMs": 1163,
    "segs": [ {
      "utf8": "Sorry!\""
    } ]
  }, {
    "tStartMs": 295795,
    "dDurationMs": 1165,
    "segs": [ {
      "utf8": "(Sigh)"
    } ]
  }, {
    "tStartMs": 298325,
    "dDurationMs": 3369,
    "segs": [ {
      "utf8": "Now, what is going on here?"
    } ]
  }, {
    "tStartMs": 303481,
    "dDurationMs": 2691,
    "segs": [ {
      "utf8": "The Instant Gratification Monkey\ndoes not seem like a guy"
    } ]
  }, {
    "tStartMs": 306196,
    "dDurationMs": 1254,
    "segs": [ {
      "utf8": "you want behind the wheel."
    } ]
  }, {
    "tStartMs": 307474,
    "dDurationMs": 1945,
    "segs": [ {
      "utf8": "He lives entirely in the present moment."
    } ]
  }, {
    "tStartMs": 309443,
    "dDurationMs": 2828,
    "segs": [ {
      "utf8": "He has no memory of the past,\nno knowledge of the future,"
    } ]
  }, {
    "tStartMs": 312295,
    "dDurationMs": 1697,
    "segs": [ {
      "utf8": "and he only cares about two things:"
    } ]
  }, {
    "tStartMs": 314016,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "easy and fun."
    } ]
  }, {
    "tStartMs": 316338,
    "dDurationMs": 3092,
    "segs": [ {
      "utf8": "Now, in the animal world, that works fine."
    } ]
  }, {
    "tStartMs": 319454,
    "dDurationMs": 1208,
    "segs": [ {
      "utf8": "If you're a dog"
    } ]
  }, {
    "tStartMs": 320686,
    "dDurationMs": 3571,
    "segs": [ {
      "utf8": "and you spend your whole life doing\nnothing other than easy and fun things,"
    } ]
  }, {
    "tStartMs": 324281,
    "dDurationMs": 1165,
    "segs": [ {
      "utf8": "you're a huge success!"
    } ]
  }, {
    "tStartMs": 325470,
    "dDurationMs": 1911,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 327405,
    "dDurationMs": 1286,
    "segs": [ {
      "utf8": "And to the Monkey,"
    } ]
  }, {
    "tStartMs": 329969,
    "dDurationMs": 2094,
    "segs": [ {
      "utf8": "humans are just another animal species."
    } ]
  }, {
    "tStartMs": 332087,
    "dDurationMs": 4506,
    "segs": [ {
      "utf8": "You have to keep well-slept, well-fed\nand propagating into the next generation,"
    } ]
  }, {
    "tStartMs": 336617,
    "dDurationMs": 2286,
    "segs": [ {
      "utf8": "which in tribal times\nmight have worked OK."
    } ]
  }, {
    "tStartMs": 338927,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "But, if you haven't noticed,\nnow we're not in tribal times."
    } ]
  }, {
    "tStartMs": 341801,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "We're in an advanced civilization,\nand the Monkey does not know what that is."
    } ]
  }, {
    "tStartMs": 345958,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "Which is why we have\nanother guy in our brain,"
    } ]
  }, {
    "tStartMs": 348263,
    "dDurationMs": 2365,
    "segs": [ {
      "utf8": "the Rational Decision-Maker,"
    } ]
  }, {
    "tStartMs": 350652,
    "dDurationMs": 3027,
    "segs": [ {
      "utf8": "who gives us the ability to do things\nno other animal can do."
    } ]
  }, {
    "tStartMs": 353703,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "We can visualize the future."
    } ]
  }, {
    "tStartMs": 355648,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "We can see the big picture."
    } ]
  }, {
    "tStartMs": 357424,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "We can make long-term plans."
    } ]
  }, {
    "tStartMs": 358798,
    "dDurationMs": 2483,
    "segs": [ {
      "utf8": "And he wants to take\nall of that into account."
    } ]
  }, {
    "tStartMs": 362138,
    "dDurationMs": 1691,
    "segs": [ {
      "utf8": "And he wants to just have us do"
    } ]
  }, {
    "tStartMs": 363853,
    "dDurationMs": 2948,
    "segs": [ {
      "utf8": "whatever makes sense\nto be doing right now."
    } ]
  }, {
    "tStartMs": 366825,
    "dDurationMs": 1389,
    "segs": [ {
      "utf8": "Now, sometimes it makes sense"
    } ]
  }, {
    "tStartMs": 368238,
    "dDurationMs": 2029,
    "segs": [ {
      "utf8": "to be doing things that are easy and fun,"
    } ]
  }, {
    "tStartMs": 370291,
    "dDurationMs": 2151,
    "segs": [ {
      "utf8": "like when you're having dinner\nor going to bed"
    } ]
  }, {
    "tStartMs": 372466,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "or enjoying well-earned leisure time."
    } ]
  }, {
    "tStartMs": 374318,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "That's why there's an overlap."
    } ]
  }, {
    "tStartMs": 375792,
    "dDurationMs": 1744,
    "segs": [ {
      "utf8": "Sometimes they agree."
    } ]
  }, {
    "tStartMs": 377560,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "But other times, it makes much more sense"
    } ]
  }, {
    "tStartMs": 380406,
    "dDurationMs": 3602,
    "segs": [ {
      "utf8": "to be doing things that are harder\nand less pleasant,"
    } ]
  }, {
    "tStartMs": 384032,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "for the sake of the big picture."
    } ]
  }, {
    "tStartMs": 385596,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "And that's when we have a conflict."
    } ]
  }, {
    "tStartMs": 388017,
    "dDurationMs": 1315,
    "segs": [ {
      "utf8": "And for the procrastinator,"
    } ]
  }, {
    "tStartMs": 389356,
    "dDurationMs": 2509,
    "segs": [ {
      "utf8": "that conflict tends to end\na certain way every time,"
    } ]
  }, {
    "tStartMs": 391889,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "leaving him spending a lot of time\nin this orange zone,"
    } ]
  }, {
    "tStartMs": 395633,
    "dDurationMs": 4327,
    "segs": [ {
      "utf8": "an easy and fun place that's entirely\nout of the Makes Sense circle."
    } ]
  }, {
    "tStartMs": 399984,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "I call it the Dark Playground."
    } ]
  }, {
    "tStartMs": 402287,
    "dDurationMs": 1624,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 403935,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Now, the Dark Playground is a place"
    } ]
  }, {
    "tStartMs": 407087,
    "dDurationMs": 3192,
    "segs": [ {
      "utf8": "that all of you procrastinators\nout there know very well."
    } ]
  }, {
    "tStartMs": 410892,
    "dDurationMs": 1804,
    "segs": [ {
      "utf8": "It's where leisure activities happen"
    } ]
  }, {
    "tStartMs": 412720,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "at times when leisure activities\nare not supposed to be happening."
    } ]
  }, {
    "tStartMs": 416418,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The fun you have in the Dark Playground"
    } ]
  }, {
    "tStartMs": 418332,
    "dDurationMs": 2483,
    "segs": [ {
      "utf8": "isn't actually fun,\nbecause it's completely unearned,"
    } ]
  }, {
    "tStartMs": 420839,
    "dDurationMs": 3215,
    "segs": [ {
      "utf8": "and the air is filled with guilt,\ndread, anxiety, self-hatred --"
    } ]
  }, {
    "tStartMs": 424078,
    "dDurationMs": 2118,
    "segs": [ {
      "utf8": "all of those good procrastinator feelings."
    } ]
  }, {
    "tStartMs": 426703,
    "dDurationMs": 3476,
    "segs": [ {
      "utf8": "And the question is, in this situation,\nwith the Monkey behind the wheel,"
    } ]
  }, {
    "tStartMs": 430203,
    "dDurationMs": 3593,
    "segs": [ {
      "utf8": "how does the procrastinator ever get\nhimself over here to this blue zone,"
    } ]
  }, {
    "tStartMs": 433820,
    "dDurationMs": 3281,
    "segs": [ {
      "utf8": "a less pleasant place, but where\nreally important things happen?"
    } ]
  }, {
    "tStartMs": 437125,
    "dDurationMs": 5037,
    "segs": [ {
      "utf8": "Well, turns out the procrastinator\nhas a guardian angel,"
    } ]
  }, {
    "tStartMs": 442186,
    "dDurationMs": 3208,
    "segs": [ {
      "utf8": "someone who's always looking\ndown on him and watching over him"
    } ]
  }, {
    "tStartMs": 445418,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "in his darkest moments --"
    } ]
  }, {
    "tStartMs": 446872,
    "dDurationMs": 2095,
    "segs": [ {
      "utf8": "someone called the Panic Monster."
    } ]
  }, {
    "tStartMs": 448991,
    "dDurationMs": 3078,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 454386,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Now, the Panic Monster\nis dormant most of the time,"
    } ]
  }, {
    "tStartMs": 459270,
    "dDurationMs": 3902,
    "segs": [ {
      "utf8": "but he suddenly wakes up\nanytime a deadline gets too close"
    } ]
  }, {
    "tStartMs": 463196,
    "dDurationMs": 2045,
    "segs": [ {
      "utf8": "or there's danger of public embarrassment,"
    } ]
  }, {
    "tStartMs": 465265,
    "dDurationMs": 2511,
    "segs": [ {
      "utf8": "a career disaster or some other\nscary consequence."
    } ]
  }, {
    "tStartMs": 467800,
    "dDurationMs": 4172,
    "segs": [ {
      "utf8": "And importantly, he's the only thing\nthe Monkey is terrified of."
    } ]
  }, {
    "tStartMs": 471996,
    "dDurationMs": 4578,
    "segs": [ {
      "utf8": "Now, he became very relevant\nin my life pretty recently,"
    } ]
  }, {
    "tStartMs": 476598,
    "dDurationMs": 3246,
    "segs": [ {
      "utf8": "because the people of TED\nreached out to me about six months ago"
    } ]
  }, {
    "tStartMs": 479868,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "and invited me to do a TED Talk."
    } ]
  }, {
    "tStartMs": 481913,
    "dDurationMs": 2428,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 487058,
    "dDurationMs": 1907,
    "segs": [ {
      "utf8": "Now, of course, I said yes."
    } ]
  }, {
    "tStartMs": 488989,
    "dDurationMs": 3805,
    "segs": [ {
      "utf8": "It's always been a dream of mine\nto have done a TED Talk in the past."
    } ]
  }, {
    "tStartMs": 492818,
    "dDurationMs": 3972,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 496814,
    "dDurationMs": 3697,
    "segs": [ {
      "utf8": "(Applause)"
    } ]
  }, {
    "tStartMs": 504203,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "But in the middle of all this excitement,"
    } ]
  }, {
    "tStartMs": 506196,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "the Rational Decision-Maker seemed\nto have something else on his mind."
    } ]
  }, {
    "tStartMs": 509521,
    "dDurationMs": 2548,
    "segs": [ {
      "utf8": "He was saying, \"Are we clear\non what we just accepted?"
    } ]
  }, {
    "tStartMs": 512093,
    "dDurationMs": 3249,
    "segs": [ {
      "utf8": "Do we get what's going to be now\nhappening one day in the future?"
    } ]
  }, {
    "tStartMs": 515366,
    "dDurationMs": 2267,
    "segs": [ {
      "utf8": "We need to sit down\nand work on this right now.\""
    } ]
  }, {
    "tStartMs": 517657,
    "dDurationMs": 3265,
    "segs": [ {
      "utf8": "And the Monkey said, \"Totally agree,\nbut let's just open Google Earth"
    } ]
  }, {
    "tStartMs": 520946,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and zoom in to the bottom of India,\nlike 200 feet above the ground,"
    } ]
  }, {
    "tStartMs": 524130,
    "dDurationMs": 3621,
    "segs": [ {
      "utf8": "and scroll up for two and a half hours\ntil we get to the top of the country,"
    } ]
  }, {
    "tStartMs": 527775,
    "dDurationMs": 1978,
    "segs": [ {
      "utf8": "so we can get a better feel for India.\""
    } ]
  }, {
    "tStartMs": 529777,
    "dDurationMs": 4435,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 535149,
    "dDurationMs": 1485,
    "segs": [ {
      "utf8": "So that's what we did that day."
    } ]
  }, {
    "tStartMs": 536658,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 540604,
    "dDurationMs": 3896,
    "segs": [ {
      "utf8": "As six months turned into four\nand then two and then one,"
    } ]
  }, {
    "tStartMs": 544524,
    "dDurationMs": 3095,
    "segs": [ {
      "utf8": "the people of TED decided\nto release the speakers."
    } ]
  }, {
    "tStartMs": 547643,
    "dDurationMs": 2612,
    "segs": [ {
      "utf8": "And I opened up the website,\nand there was my face"
    } ]
  }, {
    "tStartMs": 550279,
    "dDurationMs": 1356,
    "segs": [ {
      "utf8": "staring right back at me."
    } ]
  }, {
    "tStartMs": 551659,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And guess who woke up?"
    } ]
  }, {
    "tStartMs": 553283,
    "dDurationMs": 3115,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 557430,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "So the Panic Monster\nstarts losing his mind,"
    } ]
  }, {
    "tStartMs": 559904,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "and a few seconds later,\nthe whole system's in mayhem."
    } ]
  }, {
    "tStartMs": 562674,
    "dDurationMs": 2446,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 567511,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "And the Monkey -- remember,\nhe's terrified of the Panic Monster --"
    } ]
  }, {
    "tStartMs": 570636,
    "dDurationMs": 1158,
    "segs": [ {
      "utf8": "boom, he's up the tree!"
    } ]
  }, {
    "tStartMs": 571818,
    "dDurationMs": 1151,
    "segs": [ {
      "utf8": "And finally,"
    } ]
  }, {
    "tStartMs": 572993,
    "dDurationMs": 2596,
    "segs": [ {
      "utf8": "finally, the Rational Decision-Maker\ncan take the wheel"
    } ]
  }, {
    "tStartMs": 575613,
    "dDurationMs": 1718,
    "segs": [ {
      "utf8": "and I can start working on the talk."
    } ]
  }, {
    "tStartMs": 577355,
    "dDurationMs": 2288,
    "segs": [ {
      "utf8": "Now, the Panic Monster explains"
    } ]
  }, {
    "tStartMs": 579667,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "all kinds of pretty insane\nprocrastinator behavior,"
    } ]
  }, {
    "tStartMs": 583172,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "like how someone like me\ncould spend two weeks"
    } ]
  }, {
    "tStartMs": 585530,
    "dDurationMs": 3844,
    "segs": [ {
      "utf8": "unable to start the opening\nsentence of a paper,"
    } ]
  }, {
    "tStartMs": 589398,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "and then miraculously find\nthe unbelievable work ethic"
    } ]
  }, {
    "tStartMs": 592193,
    "dDurationMs": 3096,
    "segs": [ {
      "utf8": "to stay up all night\nand write eight pages."
    } ]
  }, {
    "tStartMs": 596385,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "And this entire situation,\nwith the three characters --"
    } ]
  }, {
    "tStartMs": 599391,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "this is the procrastinator's system."
    } ]
  }, {
    "tStartMs": 602096,
    "dDurationMs": 3425,
    "segs": [ {
      "utf8": "It's not pretty, but in the end, it works."
    } ]
  }, {
    "tStartMs": 605545,
    "dDurationMs": 4062,
    "segs": [ {
      "utf8": "This is what I decided to write about\non the blog a couple of years ago."
    } ]
  }, {
    "tStartMs": 609631,
    "dDurationMs": 2971,
    "segs": [ {
      "utf8": "When I did, I was amazed by the response."
    } ]
  }, {
    "tStartMs": 612626,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "Literally thousands of emails came in,"
    } ]
  }, {
    "tStartMs": 614803,
    "dDurationMs": 2777,
    "segs": [ {
      "utf8": "from all different kinds of people\nfrom all over the world,"
    } ]
  }, {
    "tStartMs": 617604,
    "dDurationMs": 1738,
    "segs": [ {
      "utf8": "doing all different kinds of things."
    } ]
  }, {
    "tStartMs": 619366,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "These are people who were nurses,\nbankers, painters, engineers"
    } ]
  }, {
    "tStartMs": 622356,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "and lots and lots of PhD students."
    } ]
  }, {
    "tStartMs": 624702,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 626727,
    "dDurationMs": 2288,
    "segs": [ {
      "utf8": "And they were all writing,\nsaying the same thing:"
    } ]
  }, {
    "tStartMs": 629039,
    "dDurationMs": 1952,
    "segs": [ {
      "utf8": "\"I have this problem too.\""
    } ]
  }, {
    "tStartMs": 631015,
    "dDurationMs": 3829,
    "segs": [ {
      "utf8": "But what struck me was the contrast\nbetween the light tone of the post"
    } ]
  }, {
    "tStartMs": 634868,
    "dDurationMs": 2095,
    "segs": [ {
      "utf8": "and the heaviness of these emails."
    } ]
  }, {
    "tStartMs": 636987,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "These people were writing\nwith intense frustration"
    } ]
  }, {
    "tStartMs": 640094,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "about what procrastination\nhad done to their lives,"
    } ]
  }, {
    "tStartMs": 642880,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "about what this Monkey had done to them."
    } ]
  }, {
    "tStartMs": 646902,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "And I thought about this, and I said,"
    } ]
  }, {
    "tStartMs": 649892,
    "dDurationMs": 3112,
    "segs": [ {
      "utf8": "well, if the procrastinator's system\nworks, then what's going on?"
    } ]
  }, {
    "tStartMs": 653028,
    "dDurationMs": 2486,
    "segs": [ {
      "utf8": "Why are all of these people\nin such a dark place?"
    } ]
  }, {
    "tStartMs": 655538,
    "dDurationMs": 3298,
    "segs": [ {
      "utf8": "Well, it turns out that there's\ntwo kinds of procrastination."
    } ]
  }, {
    "tStartMs": 659987,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "Everything I've talked about today,\nthe examples I've given,"
    } ]
  }, {
    "tStartMs": 662845,
    "dDurationMs": 1151,
    "segs": [ {
      "utf8": "they all have deadlines."
    } ]
  }, {
    "tStartMs": 664020,
    "dDurationMs": 1298,
    "segs": [ {
      "utf8": "And when there's deadlines,"
    } ]
  }, {
    "tStartMs": 665342,
    "dDurationMs": 2925,
    "segs": [ {
      "utf8": "the effects of procrastination\nare contained to the short term"
    } ]
  }, {
    "tStartMs": 668291,
    "dDurationMs": 1913,
    "segs": [ {
      "utf8": "because the Panic Monster gets involved."
    } ]
  }, {
    "tStartMs": 670228,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "But there's a second kind\nof procrastination"
    } ]
  }, {
    "tStartMs": 672306,
    "dDurationMs": 2487,
    "segs": [ {
      "utf8": "that happens in situations\nwhen there is no deadline."
    } ]
  }, {
    "tStartMs": 674817,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "So if you wanted a career\nwhere you're a self-starter --"
    } ]
  }, {
    "tStartMs": 677531,
    "dDurationMs": 2413,
    "segs": [ {
      "utf8": "something in the arts,\nsomething entrepreneurial --"
    } ]
  }, {
    "tStartMs": 679968,
    "dDurationMs": 3525,
    "segs": [ {
      "utf8": "there's no deadlines on those things\nat first, because nothing's happening,"
    } ]
  }, {
    "tStartMs": 683517,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "not until you've gone out\nand done the hard work"
    } ]
  }, {
    "tStartMs": 685785,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "to get momentum, get things going."
    } ]
  }, {
    "tStartMs": 687435,
    "dDurationMs": 3078,
    "segs": [ {
      "utf8": "There's also all kinds of important things\noutside of your career"
    } ]
  }, {
    "tStartMs": 690537,
    "dDurationMs": 1605,
    "segs": [ {
      "utf8": "that don't involve any deadlines,"
    } ]
  }, {
    "tStartMs": 692166,
    "dDurationMs": 3265,
    "segs": [ {
      "utf8": "like seeing your family or exercising\nand taking care of your health,"
    } ]
  }, {
    "tStartMs": 695455,
    "dDurationMs": 1404,
    "segs": [ {
      "utf8": "working on your relationship"
    } ]
  }, {
    "tStartMs": 696883,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "or getting out of a relationship\nthat isn't working."
    } ]
  }, {
    "tStartMs": 699588,
    "dDurationMs": 5148,
    "segs": [ {
      "utf8": "Now if the procrastinator's only mechanism\nof doing these hard things"
    } ]
  }, {
    "tStartMs": 704760,
    "dDurationMs": 1885,
    "segs": [ {
      "utf8": "is the Panic Monster, that's a problem,"
    } ]
  }, {
    "tStartMs": 706669,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "because in all of these\nnon-deadline situations,"
    } ]
  }, {
    "tStartMs": 709493,
    "dDurationMs": 1628,
    "segs": [ {
      "utf8": "the Panic Monster doesn't show up."
    } ]
  }, {
    "tStartMs": 711145,
    "dDurationMs": 1452,
    "segs": [ {
      "utf8": "He has nothing to wake up for,"
    } ]
  }, {
    "tStartMs": 712621,
    "dDurationMs": 2698,
    "segs": [ {
      "utf8": "so the effects of procrastination,\nthey're not contained;"
    } ]
  }, {
    "tStartMs": 715343,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "they just extend outward forever."
    } ]
  }, {
    "tStartMs": 717953,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "And it's this long-term\nkind of procrastination"
    } ]
  }, {
    "tStartMs": 720717,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "that's much less visible\nand much less talked about"
    } ]
  }, {
    "tStartMs": 723822,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "than the funnier, short-term\ndeadline-based kind."
    } ]
  }, {
    "tStartMs": 726747,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "It's usually suffered\nquietly and privately."
    } ]
  }, {
    "tStartMs": 730816,
    "dDurationMs": 1154,
    "segs": [ {
      "utf8": "And it can be the source"
    } ]
  }, {
    "tStartMs": 731994,
    "dDurationMs": 3735,
    "segs": [ {
      "utf8": "of a huge amount of long-term\nunhappiness, and regrets."
    } ]
  }, {
    "tStartMs": 736576,
    "dDurationMs": 2872,
    "segs": [ {
      "utf8": "And I thought, that's why\nthose people are emailing,"
    } ]
  }, {
    "tStartMs": 739472,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "and that's why they're\nin such a bad place."
    } ]
  }, {
    "tStartMs": 741998,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "It's not that they're cramming\nfor some project."
    } ]
  }, {
    "tStartMs": 744766,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "It's that long-term procrastination\nhas made them feel like a spectator,"
    } ]
  }, {
    "tStartMs": 748211,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "at times, in their own lives."
    } ]
  }, {
    "tStartMs": 750594,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "The frustration is not\nthat they couldn't achieve their dreams;"
    } ]
  }, {
    "tStartMs": 753600,
    "dDurationMs": 3089,
    "segs": [ {
      "utf8": "it's that they weren't even\nable to start chasing them."
    } ]
  }, {
    "tStartMs": 756713,
    "dDurationMs": 4183,
    "segs": [ {
      "utf8": "So I read these emails\nand I had a little bit of an epiphany --"
    } ]
  }, {
    "tStartMs": 762182,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "that I don't think\nnon-procrastinators exist."
    } ]
  }, {
    "tStartMs": 765979,
    "dDurationMs": 3236,
    "segs": [ {
      "utf8": "That's right -- I think all of you\nare procrastinators."
    } ]
  }, {
    "tStartMs": 769898,
    "dDurationMs": 1914,
    "segs": [ {
      "utf8": "Now, you might not all be a mess,"
    } ]
  }, {
    "tStartMs": 771836,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "like some of us,"
    } ]
  }, {
    "tStartMs": 773210,
    "dDurationMs": 1529,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 774763,
    "dDurationMs": 3316,
    "segs": [ {
      "utf8": "and some of you may have\na healthy relationship with deadlines,"
    } ]
  }, {
    "tStartMs": 778103,
    "dDurationMs": 2524,
    "segs": [ {
      "utf8": "but remember: the Monkey's sneakiest trick"
    } ]
  }, {
    "tStartMs": 780651,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "is when the deadlines aren't there."
    } ]
  }, {
    "tStartMs": 783249,
    "dDurationMs": 2032,
    "segs": [ {
      "utf8": "Now, I want to show you one last thing."
    } ]
  }, {
    "tStartMs": 785305,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "I call this a Life Calendar."
    } ]
  }, {
    "tStartMs": 788352,
    "dDurationMs": 4279,
    "segs": [ {
      "utf8": "That's one box for every week\nof a 90-year life."
    } ]
  }, {
    "tStartMs": 793345,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "That's not that many boxes,"
    } ]
  }, {
    "tStartMs": 794958,
    "dDurationMs": 2974,
    "segs": [ {
      "utf8": "especially since we've already\nused a bunch of those."
    } ]
  }, {
    "tStartMs": 798607,
    "dDurationMs": 5132,
    "segs": [ {
      "utf8": "So I think we need to all take a long,\nhard look at that calendar."
    } ]
  }, {
    "tStartMs": 804977,
    "dDurationMs": 3013,
    "segs": [ {
      "utf8": "We need to think about what\nwe're really procrastinating on,"
    } ]
  }, {
    "tStartMs": 808014,
    "dDurationMs": 3365,
    "segs": [ {
      "utf8": "because everyone is procrastinating\non something in life."
    } ]
  }, {
    "tStartMs": 812782,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "We need to stay aware\nof the Instant Gratification Monkey."
    } ]
  }, {
    "tStartMs": 817455,
    "dDurationMs": 2492,
    "segs": [ {
      "utf8": "That's a job for all of us."
    } ]
  }, {
    "tStartMs": 820669,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "And because there's not\nthat many boxes on there,"
    } ]
  }, {
    "tStartMs": 822993,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "it's a job that should\nprobably start today."
    } ]
  }, {
    "tStartMs": 825307,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Well, maybe not today, but ..."
    } ]
  }, {
    "tStartMs": 828331,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "(Laughter)"
    } ]
  }, {
    "tStartMs": 829996,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "You know."
    } ]
  }, {
    "tStartMs": 831576,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "Sometime soon."
    } ]
  }, {
    "tStartMs": 833393,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 834626,
    "dDurationMs": 7998,
    "segs": [ {
      "utf8": "(Applause)"
    } ]
  } ]
}
